# ==============================================================================
# GigaMind Environment Configuration Template
# ==============================================================================

# Database Connection (Neon Lakebase Postgres + pgvector)
# Format: postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-misty-star-91661411-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-misty-star-91661411.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_PATH=./gigamind.db

# Neon Context & API
NEON_API_KEY=YOUR_NEON_API_KEY
NEON_PROJECT_ID=misty-star-91661411
NEON_ORG_ID=org-blue-boat-32660972

# GigaMind Server & Security
PORT=8000
ENVIRONMENT=development
GIGAMIND_API_KEY=gigamind-secret-key-change-me

# Embeddings & AI Providers (Google Gemini Embedding 2)
# Supports single key or comma-separated round-robin pool: "key1,key2,key3"
GEMINI_API_KEY=AIzaSyKey1,AIzaSyKey2,AIzaSyKey3
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIM=768
COHERE_API_KEY=

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gigamind-storage
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=
