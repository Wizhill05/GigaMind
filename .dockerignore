# Send only build inputs. Local credentials, databases, backups and Git stay out.
**
!Dockerfile
!requirements.txt
!gigamind/
gigamind/**
!gigamind/*.py
!gigamind/db/
gigamind/db/**
!gigamind/db/*.py
!gigamind/services/
gigamind/services/**
!gigamind/services/*.py
!gigamind/routers/
gigamind/routers/**
!gigamind/routers/*.py
!gigamind/middleware/
gigamind/middleware/**
!gigamind/middleware/*.py
!gigamind/cli/
gigamind/cli/**
!gigamind/cli/*.py
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.*
!frontend/postcss.config.*
!frontend/tailwind.config.*
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
**/.env
**/.env.*
**/__pycache__
**/node_modules
**/dist
**/.git
**/*.pyc
**/*.pem
**/*.key
**/*.db
**/*.db-*
**/*.sqlite*
